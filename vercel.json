{
  "version": 2,
  "projects": [
    {
      "name": "frontend",
      "path": "frontend",
      "buildCommand": "npm run build",
      "outputDirectory": ".next",
      "framework": "nextjs",
      "env": {
        "NEXT_PUBLIC_API_URL": "@api_url"
      }
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": {
      "type": "plaintext",
      "description": "Backend API URL"
    }
  }
}
